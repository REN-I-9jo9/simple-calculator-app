<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Simple_Caculator_App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Simple_Caculator_App.Views"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="780"
        Width="360"
        Height="780"
        MinWidth="360"
        MinHeight="780"
        MaxWidth="360"
        MaxHeight="780"
        x:Class="Simple_Caculator_App.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Simple_Caculator_App">
        <views:MainView />
</Window>
